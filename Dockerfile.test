
FROM node:22.19.0-alpine

WORKDIR /app

# Install dependencies (must be before NODE_ENV=test to ensure dev deps are installed)
COPY package.json package-lock.json ./
RUN npm ci

# Set test environment after dependencies are installed
ENV NODE_ENV=test

# Copy source code
COPY src ./src
COPY tests ./tests
COPY eslint.config.mjs .eslintrc.js ./

CMD ["npm", "run", "test"]
